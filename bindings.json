// o-fleet's default key rows (ochazuke bindings, JSONC). A user's bindings.json overrides them; o-fleet bindings list prints the effective rows.
{
  "bindings": [
    {"context": "fleet/normal", "bindings": {
      "R": {"action": "machine.status", "args": {"machines": "*"}, "hint": "status all"},
      "q": {"action": "app.quit", "hint": "quit"}
    }},
    {"context": "machine/normal", "bindings": {
      "enter": {"action": "machine.df", "hint": "df"},
      "s": {"action": "machine.status", "hint": "status"},
      "p": {"action": "machine.ping", "hint": "ping"},
      "d d": {"action": "machine.remove", "hint": "forget"}
    }}
  ]
}
